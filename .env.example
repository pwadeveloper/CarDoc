# Server-side only. Never prefix secrets with VITE_.
GEMINI_API_KEY=
CARDOC_AI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Optional separate model for offline page translation; must support images + structured outputs.
CARDOC_TRANSLATION_MODEL=

# Optional: gemini or openai. Defaults to Gemini when GEMINI_API_KEY is set.
CARDOC_TRANSLATION_PROVIDER=
